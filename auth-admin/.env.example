# ── 사이트 ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# (선택) 상단 「홈페이지」 링크가 가리킬 메스도스랩 홈페이지 주소
NEXT_PUBLIC_HOMEPAGE_URL=

# ── Clerk: 회원가입·로그인 (필수 — 비우면 회원 기능이 꺼진다) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# 개발 전용: 키 없이 Clerk 임시 개발 인스턴스로 시연하려면 1 (운영 빌드에서는 무시됨)
NEXT_PUBLIC_CLERK_KEYLESS=

# ── 관리자: 이 목록에 있는 Clerk 계정만 /admin 에 들어온다 ──
# 목록이 모두 비어 있으면 아무도 들어올 수 없다. 이메일·번호는 Clerk 에서 인증이 끝난 것만 인정한다.
ADMIN_EMAILS=
# 휴대폰: 010-1234-5678 도 +82 10 1234 5678 도 같은 번호로 본다. 쉼표로 여러 개.
ADMIN_PHONES=
# (선택) Clerk 사용자 ID(user_...)로 직접 지정
ADMIN_CLERK_USER_IDS=

# ── 인증키(라이선스) 저장소: Supabase ──
# Supabase SQL editor 에서 supabase/license_keys.sql 을 한 번 실행한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RELEASES_BUCKET=releases

# 서명 개인키(PEM). 줄바꿈은 \n 으로 적어도 된다. 앱에 구운 공개키와 한 쌍이어야 한다.
LICENSE_PRIVATE_KEY=
# 발급 도구(CLI)가 쓰는 관리자 토큰 — 길고 무작위로.
LICENSE_ADMIN_TOKEN=
# 선택: 온라인 임대 기간(일, 기본 7) · "오늘"을 세는 시간대(UTC+N, 기본 9=한국)
LICENSE_LEASE_DAYS=7
LICENSE_TZ_OFFSET_HOURS=9

# ── 프로그램 배포처: GitHub Release (기본값: paulshon/Methodos-Lab-) ──
# 예전 paulshon2/methodosbasic2 에서 옮겼다. 다른 저장소·태그를 쓰려면 아래를 바꾼다.
GITHUB_RELEASE_REPO=paulshon/Methodos-Lab-
GITHUB_RELEASE_TAG=v22.20.1-authv1
# 통째 URL 로 덮어쓰기(있으면 가장 우선). mac 은 아직 Google Drive 기본값.
NEXT_PUBLIC_DOWNLOAD_WIN_PORTABLE_URL=
NEXT_PUBLIC_DOWNLOAD_WIN_SETUP_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_X64_DMG_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_ARM64_DMG_URL=
STORAGE_PATH_WIN_PORTABLE=MethodosBasic-LT-4-all-v4-R20-Learn-AuthV1.exe

# 로컬 개발: 폴더에서 exe 를 직접 스트리밍 (production 에서는 쓰지 않음)
LOCAL_RELEASES_DIR=

# ── 시험 전용(운영 금지) ──
# Clerk 없이 회원 목록을 JSON 으로 흉내낼 때: [{id,email,emailVerified,name,createdAt,lastSignInAt}]
MEMBERS_DEV_FILE=
